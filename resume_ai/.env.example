# Gere uma chave para o Django e mantenha este arquivo fora do Git (.env).
DJANGO_SECRET_KEY=gere_uma_chave_secreta_para_o_django
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# Chave da API do Google Gemini
GEMINI_API_KEY=COLOQUE_SUA_CHAVE_AQUI

# Configurações de e-mail para envio de códigos de redefinição de senha
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=seuemail@gmail.com
EMAIL_HOST_PASSWORD=chave_de_app_do_google
